    <string name="guide_home_1">Your favorites at the top, then the categories and all the channels.</string>
    <string name="guide_home_2">Hold OK on a channel: add to favorites, hide it, choose its stream or move it.</string>
    <string name="guide_home_3">Hold OK on a category to hide it.</string>
    <string name="guide_player_title">While watching</string>
    <string name="guide_player_1">↑ ↓ or CH+ CH−: next or previous channel.</string>
