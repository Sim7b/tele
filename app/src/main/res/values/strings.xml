    <string name="guide_welcome_title">Welcome to Télé</string>
    <string name="guide_welcome_1">Télé is fully driven by the remote: arrows to move, OK to open, Back to go back.</string>
    <string name="guide_welcome_2">Start by adding a source (Dispatcharr, Xtream Codes or M3U playlist) in the settings, with the gear at the top right.</string>
