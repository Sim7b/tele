<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (16:9): "Télé" logo centered on a graphite background -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <!-- Gradient background -->
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180">
                <item android:offset="0" android:color="#FF232833" />
                <item android:offset="1" android:color="#FF0A0C10" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Subtle glow behind the screen -->
    <path android:pathData="M160,80 m-110,0 a110,70 0 1 1 220,0 a110,70 0 1 1 -220,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="160"
                android:centerY="80"
                android:gradientRadius="110">
                <item android:offset="0" android:color="#1AFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Screen -->
    <path
        android:pathData="M120,40 H200 A14,14 0 0 1 214,54 V106 A14,14 0 0 1 200,120 H120 A14,14 0 0 1 106,106 V54 A14,14 0 0 1 120,40 Z"
        android:strokeColor="#F2FFFFFF"
        android:strokeWidth="4.5"
        android:fillColor="#00000000" />
    <!-- Stand -->
    <path
        android:pathData="M140,134 H180"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <!-- "Télé" lettering: geometric strokes, rounded caps -->
    <path
        android:pathData="M121,62 H139 M130,62 V98 M172,60 V98"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M144,88 H164 A10,10 0 1 0 161.1,95.1 M180,88 H200 A10,10 0 1 0 197.1,95.1 M152,71 L158,65 M188,71 L194,65"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- Indicator light -->
    <path
        android:pathData="M203,111 m-2.2,0 a2.2,2.2 0 1 1 4.4,0 a2.2,2.2 0 1 1 -4.4,0"
        android:fillColor="#FF22D3EE" />
</vector>
